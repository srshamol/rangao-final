# Supabase Configuration
# You can get these from your Supabase project settings -> API: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"

# Server-only Database Secrets (for Admin scripts / CAPI order lookup)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-for-admin-backend-only"

# Meta (Facebook) Pixel & Conversions API (CAPI) Configuration
# Client-side:
NEXT_PUBLIC_META_PIXEL_ID="your_meta_pixel_id"
VITE_META_PIXEL_ID="your_meta_pixel_id"
NEXT_PUBLIC_META_ENABLED="true"

# Server-only (Never expose to browser!):
META_PIXEL_ID="your_meta_pixel_id"
META_CAPI_ACCESS_TOKEN="your_meta_conversions_api_access_token"
META_CAPI_ENABLED="true"
META_TEST_EVENT_CODE="" # Optional: e.g. "TEST12345" from Meta Events Manager Test Events tab

# Google & TikTok Integrations (Optional)
VITE_GA_ID=""
VITE_GTM_ID=""
VITE_TIKTOK_PIXEL_ID=""
